NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3002
# Number of trusted reverse proxies in front of the API (0 for direct local access).
TRUST_PROXY_HOPS=0
SESSION_SECRET=replace-with-a-long-random-secret
POSTGRES_PASSWORD=local_only_change_me
DATABASE_URL=postgres://marshgo:local_only_change_me@127.0.0.1:5434/marshgo
REDIS_URL=redis://127.0.0.1:6380
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost
AUTH_DEV_BYPASS=false
AUTH_DEV_OTP=false
# Production-only providers. Real credentials must be injected by a secret manager.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ROUTING_ENGINE_URL=
OSRM_URL=
ROUTING_PRIMARY=osrm
TRAFFIC_PROVIDER=none
GEOCODING_ENGINE_URL=
GEOCODING_REVERSE_URL=
GEOCODING_API_KEY=
MAP_RENDERER=maplibre
MAP_DATA_PROVIDER=marshgo
MAP_STYLE_MANIFEST_URL=
MAP_DATA_MANIFEST_URL=
HERE_ROUTING_ENABLED=false
HERE_TRAFFIC_ENABLED=false
TOMTOM_ROUTING_ENABLED=false
TOMTOM_TRAFFIC_ENABLED=false
# Account deletion requests require an approved cooling-off policy and operational purge worker.
ACCOUNT_DELETION_COOLING_OFF_DAYS=30
# Ephemeral confirmed-booking pickup sharing. Latest locations are stored in Redis with TTL.
RENDEZVOUS_GEOFENCE_METERS=75
RENDEZVOUS_LEAD_MINUTES=15
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

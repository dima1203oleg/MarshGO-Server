NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3002
# Number of trusted reverse proxies in front of the API (0 for direct local access).
TRUST_PROXY_HOPS=0
SESSION_SECRET=replace-with-a-long-random-secret
POSTGRES_PASSWORD=local_only_change_me
DATABASE_URL=postgres://marshgo:local_only_change_me@127.0.0.1:5434/marshgo
REDIS_URL=redis://127.0.0.1:6380
# Optional disposable L2 cache; keep it separate from session/realtime/rate-limit Redis.
REDIS_CACHE_URL=redis://127.0.0.1:6381
CACHE_L1_MAX_ENTRIES=5000
CACHE_L1_MAX_BYTES=16777216
CACHE_L2_MAX_ENTRY_BYTES=2097152
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost
AUTH_DEV_BYPASS=false
AUTH_DEV_OTP=false
# OTP is disabled. Set SMS_PROVIDER=twilio only after approving the provider and injecting its credentials securely.
SMS_PROVIDER=disabled
# Required only when SMS_PROVIDER=twilio; inject via a secret manager, never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ROUTING_ENGINE_URL=
OSRM_URL=
# Set to the immutable routing graph/data release identifier before enabling route geometry caching.
OSRM_GRAPH_VERSION=
# Optional OSRM foot router. A service root (http://host:port) or /route/v1 is normalized to
# /route/v1/foot; an explicit /route/v1/foot endpoint is also accepted. Without it, walks remain estimates.
WALKING_ROUTING_URL=
# Optional compact JSON array of {"bbox":[minLon,minLat,maxLon,maxLat],"url":"https://..."} for city-specific foot graphs.
WALKING_ROUTING_URLS=
# Set when the pedestrian graph differs from OSRM_GRAPH_VERSION.
WALKING_GRAPH_VERSION=
# Optional OSRM cycling router (a self-hosted bike graph). A service root (http://host:port) or
# /route/v1 is normalized to /route/v1/bike; an explicit bike-profile URL is also accepted. There is
# no public default and no fallback router — without it, bike legs remain straight-line estimates.
BIKING_ROUTING_URL=
# Set when the cycling graph differs from OSRM_GRAPH_VERSION.
BIKING_GRAPH_VERSION=
ROUTING_MAX_CONCURRENCY=12
ROUTING_MAX_QUEUE=24
ROUTING_QUEUE_WAIT_MS=2500
CACHE_OSRM_TTL_MS=21600000
CACHE_WALKING_TTL_MS=10800000
# GTFS worker isolate heap ceiling, in MiB. Without it the worker inherits the same per-isolate
# limit as the API process: inside an 1800 MiB container Node reported 1496 MiB for each, so a
# heavy search could demand 2992 MiB and be killed by the kernel (exit 137, taking auth and
# bookings with it) instead of raising a catchable worker error. Unset, the ceiling is derived as
# 60% of the cgroup memory limit (1800 MiB -> 1080 MiB, headroom over the measured 843 MiB peak
# for 63 134 segments); the remaining 40% belongs to the API isolate. Off-container and for
# limits below the 384 MiB floor the ceiling is left at the Node default. Values are clamped to
# 3072 and non-numeric or below-floor ones are ignored; the decision is logged once at worker
# start as {"event":"gtfs.worker.memory_ceiling"}.
# If NODE_OPTIONS already pins --max-old-space-size, that flag applies to every isolate and wins
# over the worker ceiling (measured on Node 24.21.0: a worker asked for 384 MiB still got 1496 MiB
# and allocated 900 MiB without failing; per-worker execArgv is refused outright). The start log
# then says {"event":"gtfs.worker.memory_ceiling_shadowed","authoritative":false,
# "nodeOptionsMaxOldSpaceMb":1400} — remove the pin from NODE_OPTIONS or raise the container memory
# to the sum of the two pins, otherwise the ceiling is only a number in a log line.
# MARSHGO_GTFS_WORKER_MAX_OLD_SPACE_MB=1080
# Optional bearer token. /metrics returns 404 unless configured and authenticated.
METRICS_BEARER_TOKEN=
ROUTING_PRIMARY=osrm
TRAFFIC_PROVIDER=none
# Choose a geocoder you operate or have approval to use. Public Nominatim does
# not allow autocomplete; use an approved Photon endpoint or self-hosted
# Nominatim/Photon service for place suggestions.
#
# Production / staging: a stable, owner-approved HTTPS endpoint with a capacity
# agreement. Leave empty until that agreement exists; /api/v1/places/suggest then
# fails closed with geocoder_unavailable instead of silently using a demo.
GEOCODING_ENGINE_URL=
GEOCODING_REVERSE_URL=
GEOCODING_PROVIDER=nominatim
# Autocomplete does not forward caller location bias unless explicitly approved.
GEOCODING_FORWARD_LOCATION_BIAS=false
GEOCODING_API_KEY=
# /readyz reports the geocoder state (ok/unreachable/misconfigured/unconfigured).
# Set true only when the geocoder is a hard dependency of this deployment; the
# default keeps the API serving routes while place search is honestly degraded.
GEOCODER_READY_REQUIRED=false
#
# DEV-ONLY SAMPLE, never production. The public Photon demo has no availability
# or rate guarantee and its usage policy is not a service agreement. Uncomment
# only for bounded local checks of the adapter, and do not copy these values into
# a deployed environment:
#   GEOCODING_PROVIDER=photon
#   GEOCODING_ENGINE_URL=https://photon.komoot.io/api
#   GEOCODING_REVERSE_URL=https://photon.komoot.io/reverse
MAP_RENDERER=maplibre
MAP_DATA_PROVIDER=marshgo
MAP_STYLE_MANIFEST_URL=
MAP_DATA_MANIFEST_URL=
HERE_ROUTING_ENABLED=false
HERE_TRAFFIC_ENABLED=false
TOMTOM_ROUTING_ENABLED=false
TOMTOM_TRAFFIC_ENABLED=false
# Account deletion requests require an approved cooling-off policy and operational purge worker.
ACCOUNT_DELETION_COOLING_OFF_DAYS=30
# Ephemeral confirmed-booking pickup sharing. Latest locations are stored in Redis with TTL.
RENDEZVOUS_GEOFENCE_METERS=75
RENDEZVOUS_LEAD_MINUTES=15
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Phones that receive the admin role after verified sign-in (comma-separated E.164). Ignored while the development OTP is visible.
ADMIN_PHONES=

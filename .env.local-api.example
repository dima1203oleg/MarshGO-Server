# Local API development stack configuration (isolated from the acceptance stack).
# Copy to .env.local-api (gitignored) and fill in the two secrets:
#   cp .env.local-api.example .env.local-api
#   openssl rand -hex 16   # -> LOCAL_API_POSTGRES_PASSWORD (must be lowercase
#                          #    hex: it is interpolated into DATABASE_URL unescaped)
#   openssl rand -hex 32   # -> LOCAL_API_SESSION_SECRET
# Never commit the filled-in file. scripts/local-api.sh refuses placeholders
# and any password that is not 32-64 lowercase hex characters.

# Required secrets (local development only).
LOCAL_API_POSTGRES_PASSWORD=replace-with-openssl-rand-hex-16
LOCAL_API_SESSION_SECRET=replace-with-openssl-rand-hex-32

# Host ports (loopback-bound). Defaults avoid the acceptance stack ports
# 5434/6380/6381 and the system defaults 5432/6379.
LOCAL_API_DB_PORT=5444
LOCAL_API_REDIS_PORT=6390
# Port the site proxies expect the API on; keep 3002 to clear the 502s.
LOCAL_API_PORT=3002

# Number of trusted reverse proxies in front of the API (0 for direct local access).
LOCAL_API_TRUST_PROXY_HOPS=0

# CORS origins allowed to call the local API (development only).
LOCAL_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3103,http://127.0.0.1:3103,http://localhost:4178,http://127.0.0.1:4178,capacitor://localhost

# Optional real upstreams. Leave empty unless you operate them; the API then
# degrades honestly (labelled estimates / unavailable), never faked data.
LOCAL_API_OSRM_URL=
LOCAL_API_WALKING_ROUTING_URL=
LOCAL_API_GEOCODING_PROVIDER=nominatim
LOCAL_API_GEOCODING_ENGINE_URL=
LOCAL_API_GEOCODING_REVERSE_URL=

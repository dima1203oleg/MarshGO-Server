{
  "name": "marshgo-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "api": "tsx server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "local:api:start": "bash scripts/local-api.sh start",
    "local:api:stop": "bash scripts/local-api.sh stop",
    "local:api:down": "bash scripts/local-api.sh down",
    "local:api:status": "bash scripts/local-api.sh status",
    "local:api:smoke": "bash scripts/local-api.sh smoke",
    "local:api:version": "bash scripts/local-api.sh version",
    "lint": "npm run lint:all",
    "lint:all": "eslint server tests",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration:bookings": "tsx --test tests/api-bookings.integration.test.ts tests/trip-editing.integration.test.ts",
    "test:integration:interval": "tsx --test tests/carpool-interval-inventory.integration.test.ts",
    "test:integration:live-drivers": "tsx --test tests/carpool-live-driver-discovery.integration.test.ts",
    "test:integration:route-progress": "tsx --test tests/carpool-route-progress.integration.test.ts",
    "test:integration:navigation": "tsx --test tests/navigation.integration.test.ts",
    "test:integration:realtime": "tsx --test tests/realtime-cluster.integration.test.ts",
    "test:integration:partners": "tsx --test tests/partner-platform.integration.test.ts",
    "test:integration:rate-limit": "tsx --test tests/redis-rate-limit.integration.test.ts",
    "test:integration:restart": "tsx --test tests/booking-restart.integration.test.ts",
    "test:integration:journey": "tsx --test tests/journey-schema.integration.test.ts",
    "test:integration:pg-socket-failure": "tsx --test tests/pg-socket-failure.integration.test.ts",
    "test:integration:journey-activation": "tsx --test tests/journey-activation.integration.test.ts",
    "test:integration:live-journey": "tsx --test tests/live-journey.integration.test.ts",
    "test:integration:direct-walking": "tsx --test tests/direct-walking-api.integration.test.ts",
    "test:integration:direct-only-walking": "tsx --test tests/direct-only-walking-api.integration.test.ts",
    "test:integration:auth-security": "tsx --test tests/auth-security-regressions.integration.test.ts",
    "test:integration:rendezvous": "tsx --test tests/two-account-rendezvous.integration.test.ts",
    "test:integration:qr-attestation": "tsx --test tests/qr-attestation-characterization.integration.test.ts",
    "test:integration": "bash scripts/run-integration-tests.sh",
    "benchmark:routing-cache": "tsx scripts/benchmark-routing-cache.ts",
    "test:load:routing": "k6 run tests/load/routing.k6.js",
    "mobility:seed": "tsx server/mobility/seedUkraine.ts",
    "acceptance:transport-feeds": "tsx scripts/transport-feed-smoke.ts --scope=all",
    "acceptance:lviv-route-feed": "tsx scripts/transport-feed-smoke.ts --scope=lviv-route",
    "mobility:audit-osm-bikes": "tsx scripts/audit-osm-bike-rentals.ts",
    "mobility:extract-osm-bikes": "bash scripts/extract-osm-bike-rentals.sh",
    "mobility:import-osm-bikes": "tsx scripts/import-osm-bike-rentals.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-presigned-post": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "pg": "^8.23.0",
    "redis": "^5.12.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "firebase-admin": "^14.5.0",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.0"
  }
}
